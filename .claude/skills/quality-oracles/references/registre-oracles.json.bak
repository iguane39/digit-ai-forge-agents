    },
    {
      "domaine": "Prompts",
      "ext": [],
      "type": "skill",
      "skill": "prompt-analyzer-l99",
      "checklist": "analyse L99 (8 couches), score /100, contrat de sortie",
      "statut": "ok",
      "non_juge": []
    },
    {
      "domaine": "Versions de dépendances (« version actuelle »)",
      "ext": [],
      "type": "kit",
      "cmd_ref": "node <projet>/compliance-pack/maj-versions.mjs <dossier-projet>",
      "checklist": "version interrogée aux registres officiels (jamais estimée)",
      "statut": "ok",
      "non_juge": []
    },
    {
      "domaine": "Conformité de rapport d'audit (kit RefAudit)",
      "ext": [],
      "type": "kit",
      "cmd_ref": "node <projet>/compliance-pack/verifier-rapport-audit.mjs \"<rapport>.html\"",
      "checklist": "checks 1-10 (placeholders, compile, domaines, familles, verdicts ADR, exécution, rendu, auto-test, versions)",
      "statut": "ok",
      "non_juge": []
    },
    {
      "domaine": "Clôture de remédiation (kit RefAudit)",
      "ext": [],
      "type": "kit",
      "cmd_ref": "node <projet>/compliance-pack/verifier-remediation.mjs \"<rapport>.html\" --status suivi.json",
      "checklist": "chaque action faite avec preuve avant nouvel audit",
      "statut": "ok",
      "non_juge": []
    },
    {
      "domaine": "Skill (audit)",
      "ext": [],
      "type": "skill",
      "skill": "ameliore-un-skill",
      "checklist": "grille 7 dimensions /5 pondérée + volet conformité oracles R1-R10 (references/regles-oracles.md)",
      "statut": "ok",
      "non_juge": [
        "conformité oracles R1-R10 (audit dédié, references/regles-oracles.md)"
      ]
    },
    {
      "domaine": "Calculs / chiffres",
      "ext": [
        ".md",
        ".html",
        ".htm"
      ],
      "type": "cli",
      "checklist": "re-somme exécutée des lignes Total/Somme des tables md/html (milliers fr, virgule/point décimal, €, %, k€) ; tolérance arrondi ; le reste marqué à vérifier",
      "statut": "partiel",
      "non_juge": [
        "calculs hors tables",
        "formules métier",
        "chiffres sans total de contrôle"
      ],
      "note": "domaine-spécifique : rejouer le calcul du livrable ; pas d'oracle générique",
      "cmd": [
        "node",
        "{skilldir}/scripts/oracle-calculs.mjs",
        "{file}"
      ],
      "content_patterns": [
        "^\\s*\\|.*\\b(total|totaux|somme|sous-?total)\\b"
      ]
    },
    {
      "domaine": "Traçabilité des affirmations chiffrées",
      "ext": [
        ".md",
        ".html",
        ".htm"
      ],
      "type": "cli",
      "cmd": [
        "node",
        "{skilldir}/scripts/oracle-claims.mjs",
        "{file}",
        "--profil",
        "{profil}"
      ],
      "checklist": "montant € hors table sans source ni « à vérifier » = bloquant ; % et grands nombres non sourcés = avertissement ; libellé répété à valeurs divergentes = bloquant ; actif selon profil",
      "statut": "partiel",
      "non_juge": [
        "véracité des sources citées",
        "affirmations non chiffrées",
        "tables → oracle-calculs"
      ]
    },
    {
      "domaine": "Nommage / convention de livraison",
      "ext": [
        ".md",
        ".html",
        ".htm",
        ".pptx",
        ".potx",
