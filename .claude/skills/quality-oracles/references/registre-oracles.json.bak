{
  "version": "2.5.0",
  "note": "Registre machine des oracles (consommé par scripts/run-oracles.mjs). Vue humaine : registre-oracles.md. Placeholders : {skilldir}=racine du skill quality-oracles, {skillsroot}=~/.claude/skills, {file}=artefact. type ∈ cli|skill|manual|kit. Statuts étendus (M3, 23/07/2026) : dormant (6 mois sans usage journalisé — routage/exécution désactivés, entrée conservée) · broken (fixture verte en échec ou dépendance non résolue — réparer ou retirer, jamais exécuter). Champs optionnels par entrée : dernier_usage (ISO, dérivé des journaux _oracles-journal*, calculé par la passe d hygiène etat-forge — jamais tenu à la main). Manifest des fixtures : champ provenance (chantier + date du défaut réel dont la fixture rouge est issue) — obligatoire pour tout oracle créé à partir du 23/07/2026, une fixture rouge sans provenance réelle laisse l oracle en partiel.",
  "oracles": [
    {
      "domaine": "Rendu HTML / visuel",
      "ext": [
        ".html",
        ".htm"
      ],
      "type": "cli",
      "cmd": [
        "python",
        "{skillsroot}/digit-ai-page-html/scripts/render_page.py",
        "{file}",
        "--output",
        "json"
      ],
      "checklist": "digit-ai-page-html/references/zero-defaut-visuel.md (V1-V7)",
      "statut": "ok",
      "non_juge": [
        "V5 croisements de flèches",
        "V6 images déformées (inspection PNG)"
      ]
    },
    {
      "domaine": "Rendu PPTX (structure & compatibilité)",
      "ext": [
        ".pptx",
        ".potx"
      ],
      "type": "cli",
      "cmd": [
        "node",
        "{skilldir}/scripts/oracle-pptx.mjs",
        "{file}",
        "--profil",
        "{profil}"
      ],
      "checklist": "intégrité zip, [Content_Types].xml en 1re entrée, zéro <p:transition>, zéro média JPEG, smoke-test conversion LibreOffice",
      "statut": "partiel",
      "non_juge": [
        "charte sémantique (kicker, logos, bijection sommaire↔intercalaires) → gate digit-ai-pptx",
        "rendu visuel slide par slide → pipeline digit-ai-pptx"
      ]
    },
    {
      "domaine": "Accessibilité (WCAG structurel)",
      "ext": [
        ".html",
        ".htm"
      ],
      "type": "cli",
      "cmd": [
        "python",
        "{skilldir}/scripts/oracle-a11y.py",
        "{file}"
      ],
      "checklist": "lang, title, alt, noms accessibles, intitulés liens/boutons, ordre des titres, id uniques, zoom, tabindex",
      "statut": "ok",
      "non_juge": [
        "audit axe-core complet",
        "contraste (render_page V2)",
        "navigation clavier"
      ]
    },
    {
      "domaine": "Performance / poids",
      "ext": [
        ".html",
        ".htm"
      ],
      "type": "cli",
      "cmd": [
        "node",
        "{skilldir}/scripts/oracle-perf.mjs",
        "{file}",
        "--profil",
        "{profil}"
      ],
      "checklist": "budgets : poids total, taille DOM, JS inline, data URIs, refs externes",
      "statut": "ok",
      "non_juge": [
        "temps de rendu réel / LCP sous charge (non déterministe)"
      ]
    },
    {
      "domaine": "Format / livraison / versioning",
      "ext": [
        ".html",
        ".htm",
        ".md",
        ".json",
        ".svg",
        ".zip",
        ".txt",
        ".css",
        ".tf",
        ".yml",
        ".yaml",
        ".csv"
      ],
      "type": "cli",
      "cmd": [
        "node",
        "{skilldir}/scripts/oracle-format.mjs",
        "{file}"
      ],
      "checklist": "encodage UTF-8, intégrité ZIP, placeholders, autoportance HTML",
      "statut": "ok",
      "non_juge": []
    },
    {
      "domaine": "Code source",
      "ext": [
        ".js",
        ".mjs",
        ".cjs",
        ".py",
        ".ts",
        ".tsx"
      ],
      "type": "cli",
      "cmd": [
        "node",
        "{skilldir}/scripts/oracle-code.mjs",
        "{file}"
      ],
      "checklist": "compilation/syntaxe (compile != s'exécute)",
      "statut": "ok",
      "non_juge": [
        "exécution & tests fonctionnels",
        "lint/typage approfondi"
      ]
    },
    {
      "domaine": "Sécurité / secrets",
      "ext": "any",
      "type": "cli",
      "cmd": [
        "node",
        "{skilldir}/scripts/oracle-secrets.mjs",
        "{file}"
      ],
      "checklist": "clés/tokens/PAT/mots de passe en clair (+ gitleaks si présent)",
      "statut": "ok",
      "non_juge": [
        "SCA (voir oracle-sca)",
        "historique git"
      ]
    },
    {
      "domaine": "Sécurité : vulnérabilités de dépendances (SCA)",
      "ext": [],
      "trigger_files": [
        "requirements.txt",
        "package.json"
      ],
      "type": "cli",
      "cmd": [
        "node",
        "{skilldir}/scripts/oracle-sca.mjs",
        "{file}"
      ],
      "checklist": "pip-audit / npm audit / OSV sur versions épinglées",
      "statut": "ok",
      "non_juge": [
        "dépendances transitives non épinglées"
      ],
      "note": "cibler un dossier projet ou un manifeste (requirements.txt / package.json)"
    },
    {
      "domaine": "Sécurité : SAST (injection / exécution dangereuse)",
      "ext": [
        ".py",
        ".js",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".jsx"
      ],
      "type": "cli",
      "cmd": [
        "node",
        "{skilldir}/scripts/oracle-sast.mjs",
        "{file}"
      ],
      "checklist": "injection SQL/commande, eval/exec, shell=True, désérialisation, XSS (semgrep/bandit si présents, sinon règles intégrées)",
      "statut": "ok",
      "non_juge": [
        "analyse de flux inter-fichiers",
        "logique métier"
      ]
    },
    {
      "domaine": "Sortie LLM / IA générative",
      "ext": [],
      "type": "cli",
      "cmd": [
        "node",
        "{skilldir}/scripts/oracle-llm.mjs",
        "{file}",
        "--schema",
        "{schema}"
      ],
      "checklist": "validation de schéma JSON (auto) + checklist de véracité (manuelle)",
      "statut": "partiel",
      "non_juge": [
        "véracité factuelle (revue sourcée / recompute)",
        "non-régression sans golden"
      ],
      "note": "partie auto = conformité de schéma ; véracité = revue humaine (loi §5)"
    },
    {
      "domaine": "Données / dataset",
      "ext": [
        ".csv",
        ".parquet",
        ".xlsx",
        ".tsv"
      ],
      "type": "skill",
      "skill": "data-quality-auditor",
      "checklist": "complétude, cohérence, distributions, anomalies, model-readiness",
      "statut": "ok",
      "non_juge": [
        "véracité métier des valeurs (le profilage juge la qualité structurelle, pas la justesse métier)"
      ]
    },
    {
      "domaine": "Schémas / diagrammes",
      "ext": [],
      "type": "skill",
      "skill": "digit-ai-schemas",
      "checklist": "canevas, routage des flèches, tooltips, charte",
