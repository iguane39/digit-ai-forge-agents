      "checklist": "fichier au préfixe de la convention du profil → doit matcher la regex complète {TypeDoc} {Client} - {Scope} - {AAAAMMJJ}{a…} ; hors préfixe → SKIP",
      "statut": "ok",
      "non_juge": [
        "fichiers hors préfixe",
        "pertinence métier des segments"
      ]
    },
    {
